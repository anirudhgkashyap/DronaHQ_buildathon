# Atlas SDR — environment variables
# Copy to .env and fill in your values.

# Database — SQLite for quick local dev, Postgres for full demo
DATABASE_URL=sqlite+aiosqlite:///./atlas_sdr.db
# DATABASE_URL=postgresql+asyncpg://atlas:atlas_dev@localhost:5432/atlas_sdr

# DronaHQ — leave blank to use the deterministic offline simulator
# HOW TO GET THESE:
#   1. Open each agent in DronaHQ → Triggers tab → Add "Webhook" trigger
#   2. Copy the unique webhook URL shown (e.g. https://studio.dronahq.com/cb/...)
#   3. Paste the FULL URL below (it starts with https://)
#   4. API key: Developer → API Keys → New Key  (format: sk_...)
DRONAHQ_BASE_URL=https://agents-backend.dronahq.com
DRONAHQ_API_KEY=your_api_key_uuid_here
# Each agent's full webhook URL (Triggers tab → Webhook → copy URL):
DRONAHQ_AGENT_PROSPECT_GENERATION=https://agents-backend.dronahq.com/webhook/YOUR_UUID
DRONAHQ_AGENT_RESEARCH_ENRICHMENT=https://agents-backend.dronahq.com/webhook/YOUR_UUID
DRONAHQ_AGENT_ICP_FIT=https://agents-backend.dronahq.com/webhook/YOUR_UUID
DRONAHQ_AGENT_OUTREACH_STRATEGIST=https://agents-backend.dronahq.com/webhook/YOUR_UUID
DRONAHQ_AGENT_PERSONALISATION=https://agents-backend.dronahq.com/webhook/YOUR_UUID
DRONAHQ_AGENT_REPLY_HANDLER=https://agents-backend.dronahq.com/webhook/YOUR_UUID

# OpenAI — for real vector embeddings; leave blank for local hash fallback
OPENAI_API_KEY=

# Channels — keep DRY_RUN=true until you want to actually send messages
CHANNELS_DRY_RUN=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
